generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id @default(uuid()) @map("_id")
  email    String @unique
  name     String
  password String 
  refreshToken String?
}

model OffreStage {
  id           String @id @default(uuid()) @map("_id")
  nomOffre     String 
  intitule     String
  description  String
}


